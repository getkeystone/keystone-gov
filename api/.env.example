# Copy to .env and edit before running locally outside Docker.
DATABASE_URL=postgresql://keystone:keystone@postgres:5432/keystone
AUDIT_HMAC_KEY=change-me-to-a-long-random-secret
# Stage 4 trust check: HHEM factual-consistency threshold (0.0-1.0).
# Answers scoring below this are refused with LOW_FACTUAL_CONSISTENCY.
# Set higher to be more aggressive; lower to be more permissive.
HHEM_THRESHOLD=0.5
