# Copy to .env and edit before running locally outside Docker.
DATABASE_URL=postgresql://keystone:keystone@postgres:5432/keystone
AUDIT_HMAC_KEY=change-me-to-a-long-random-secret
# Stage 4 trust check: HHEM factual-consistency threshold (0.0-1.0).
# Set per-environment; the operational value is not published here.
HHEM_THRESHOLD=<0.0-1.0>

# Cloudflare Access identity (optional). Default is disabled; the demo
# Bearer-session path is used when CLOUDFLARE_ACCESS_ENABLED=false, and a
# Cf-Access-Jwt-Assertion header is ignored in that mode. Once enabled,
# CLOUDFLARE_ACCESS_TEAM_DOMAIN and CLOUDFLARE_ACCESS_AUD are both mandatory:
# the service refuses to start without either (see cf_identity.validate_cf_config).
# This only configures the local identity check; it does not confirm that
# these values correspond to a real, live Cloudflare Access application.
CLOUDFLARE_ACCESS_ENABLED=false
CLOUDFLARE_ACCESS_TEAM_DOMAIN=<your-team>.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=<access-application-audience-tag>

# Internal role-simulation overlay for the CF Access path (optional, advanced).
# Lets an allowlisted, already CF-authenticated email exercise a different
# role in a session for testing. Does not apply when CF Access is disabled.
DEMO_ROLE_SIMULATION_ENABLED=false
DEMO_ROLE_SIMULATION_ALLOWED_EMAILS=<comma-separated-list-of-emails>
